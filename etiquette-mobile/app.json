{
  "expo": {
    "name": "Etiquette Tailor",
    "slug": "etiquette-tailor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "etiquette",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.etiquette.tailor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e3a5f",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.etiquette.tailor"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
